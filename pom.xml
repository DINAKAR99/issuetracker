						<version>2.2</version>
						<configuration>
							<update>true</update>
							<url>${maven.tomcat.url}</url>
							<path>/issueTracker</path>
							<username>${tomcat.username}</username>
							<password>${tomcat.password}</password>
							<!-- <warFile>${project.build.directory}/${project.build.finalName}.war.original</warFile> -->
						</configuration>
					</plugin>

				</plugins>
			</build>
		</profile>

		<profile>
			<id>uat</id>
			<properties>
				<spring.profiles.active>uat</spring.profiles.active>
			</properties>

			<build>
				<finalName>issueTracker</finalName>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-war-plugin</artifactId>
						<configuration>
						</configuration>
					</plugin>

					<plugin>
						<groupId>org.apache.tomcat.maven</groupId>
						<artifactId>tomcat7-maven-plugin</artifactId>
						<version>2.2</version>
						<configuration>
							<update>true</update>
							<url>${maven.tomcat.url}</url>
							<path>/issueTracker</path>
							<username>${tomcat.username}</username>
							<password>${tomcat.password}</password>
							<!-- <warFile>${project.build.directory}/${project.build.finalName}.war.original</warFile> -->
						</configuration>
					</plugin>

				</plugins>
			</build>
		</profile>

		<profile>
			<id>prod</id>
			<properties>
				<spring.profiles.active>prod</spring.profiles.active>
			</properties>

			<build>
				<finalName>issueTracker</finalName>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-war-plugin</artifactId>
						<configuration>
						</configuration>
					</plugin>

					<plugin>
						<groupId>org.apache.tomcat.maven</groupId>
						<artifactId>tomcat7-maven-plugin</artifactId>
						<version>2.2</version>
						<configuration>
							<update>true</update>
							<url>${maven.tomcat.url}</url>
							<path>/issueTracker</path>
							<username>${tomcat.username}</username>
							<password>${tomcat.password}</password>
							<!-- <warFile>${project.build.directory}/${project.build.finalName}.war.original</warFile> -->
						</configuration>
					</plugin>

				</plugins>
			</build>
		</profile>
